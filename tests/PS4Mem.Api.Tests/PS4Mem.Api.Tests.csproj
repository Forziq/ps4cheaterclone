<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PS4Mem.Api\PS4Mem.Api.csproj" />
  </ItemGroup>

  <!-- The same fake ps4debug server the Core tests use. -->
  <ItemGroup>
    <Compile Include="..\PS4Mem.Core.Tests\Fakes\FakePs4Server.cs" Link="Fakes\FakePs4Server.cs" />
  </ItemGroup>

  <!-- api.http is replayed by ApiHttpFileTests, so the samples can't drift from the API. -->
  <ItemGroup>
    <None Include="..\..\src\PS4Mem.Api\api.http" Link="api.http" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
