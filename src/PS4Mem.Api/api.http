# PS4 Mem API sample calls (VS Code REST Client, JetBrains HTTP client or Visual Studio).
# Start the API first:  dotnet run --project src/PS4Mem.Api
# Errors come back as {"error": "..."}: 400 bad input, 404 no such cheat, 409 not connected / already connected,
# 502 the PS4 refused or didn't answer.
# The tests replay this file top to bottom against a fake console, so keep every call working.

@host = http://127.0.0.1:5080
# A pid from GET /api/processes (the game you chose).
@pid = 85
# The game's title ID, from GET /api/processes/{pid}. Cheat lists are saved per title ID.
@titleId = CUSA11711
# A cheat id from the game's cheat list (the import below makes this one).
@cheat = a1b2c3d4

### Connection state, and the IP a connect would use
GET {{host}}/api/status

### Saved settings
GET {{host}}/api/settings

### Change some settings (only the fields you send change)
# Other fields: consoleIp, commandPort, loaderPort (9090 GoldHEN; 9020/9021 other loaders), payloadPath.
PUT {{host}}/api/settings
Content-Type: application/json

{
  "debugLogging": false
}

### Inject the payload, wait for ps4debug (up to 20 s), then connect. Once per PS4 session:
# BinLoader takes one payload, then refuses until it's toggled in GoldHEN or the PS4 restarts.
# 409 if ps4debug already answers: use Connect instead (a second copy can freeze the console).
# Optional: {"ip": "<PS4_IP>", "payloadPath": "/path/to/ps4debug.bin", "loaderPort": 9090};
# a path and port that work are saved.
POST {{host}}/api/inject
Content-Type: application/json

{}

### Status again: connected, with the ps4debug version
GET {{host}}/api/status

### Every process; the likely game has "suggested": true and a reason (you still choose)
GET {{host}}/api/processes

### Process info: name, path and title ID
GET {{host}}/api/processes/{{pid}}

### Sections with the default selection and each section's reason
GET {{host}}/api/processes/{{pid}}/maps

### Your own name filter (empty = any name), and read-only sections too
GET {{host}}/api/processes/{{pid}}/maps?filter=anon,exe&includeReadOnly=true

### Select every section
GET {{host}}/api/processes/{{pid}}/maps?all=true

### First scan: an exact 4-byte value in the default sections. Runs in the background: 202 at once.
# Other fields: "type" (u8 i8 u16 i16 u32 i32 u64 i64 f32 f64 string bytes), "compare" (exact,
# bigger than, smaller than, between with "value2", unknown initial value), "hex": true,
# "sections": ["0x200000000", ...] (start addresses; none = the default selection),
# "aligned": false (every byte), "method": "console" (compare on the PS4 when it can),
# "pauseGame": true (stop the game while scanning; always resumed afterwards, also for next scans).
# 409 while another scan runs.
POST {{host}}/api/scan/first
Content-Type: application/json

{
  "pid": {{pid}},
  "type": "u32",
  "compare": "exact",
  "value": "1500"
}

### Scan progress: server-sent events. "progress" events while the scan runs (percent, section,
# hits so far), then one "done" event with the result count and hits per section.
GET {{host}}/api/scan/progress

### Scan status once, as JSON
GET {{host}}/api/scan/status

### Results: the first 5,000 (?offset=&limit= for more, ?hex=true for hex values). "value" is what
# the scan found; "total" is every result.
GET {{host}}/api/scan/results

### Current values of the visible rows, read from the PS4 now
POST {{host}}/api/scan/results/values
Content-Type: application/json

{
  "offset": 0,
  "limit": 100
}

### Next scan on the results. Compares: exact, bigger than, smaller than, between, increased,
# increased by, decreased, decreased by, changed, unchanged. The type stays the first scan's.
POST {{host}}/api/scan/next
Content-Type: application/json

{
  "compare": "unchanged"
}

### Progress of the next scan
GET {{host}}/api/scan/progress

### Undo the last scan (back to the first scan's results)
POST {{host}}/api/scan/undo

### Cancel a running scan (fine when none runs; the previous results stay)
POST {{host}}/api/scan/cancel

### New scan: drops every result
POST {{host}}/api/scan/new

### Import a cheat list into the game's list (title ID from the process info). ?mode=merge (the
# default) adds to the saved list, and a cheat with a saved cheat's id replaces it; ?mode=replace
# makes the file the whole list. The body is a cheat file, as export makes. Writes no memory.
POST {{host}}/api/cheats/{{titleId}}/import?mode=merge
Content-Type: application/json

{
  "format": 1,
  "titleId": "{{titleId}}",
  "game": "ac3_engine_orbis_fn.elf",
  "cheats": [
    { "id": "{{cheat}}", "description": "Money", "address": "0x200000100", "type": "u32", "value": "1500",
      "section": "", "sectionStart": "0x200000000" }
  ]
}

### The game's cheat list (saved in ~/Library/Application Support/PS4Mem/cheats/<TITLEID>.json).
# Each row has "locked", and "lockError" when a lock stopped because a write failed.
GET {{host}}/api/cheats/{{titleId}}

### Add a cheat, e.g. a results row the user double-clicked: its address, section and section
# start, the scan type and a value. "hex": true reads the value as hex. 201 with its new id.
POST {{host}}/api/cheats/{{titleId}}
Content-Type: application/json

{
  "description": "Ammo",
  "address": "0x200000200",
  "type": "u32",
  "value": "1500",
  "section": "",
  "sectionStart": "0x200000000"
}

### Current values of every cheat, read from the PS4 now (reads only)
POST {{host}}/api/cheats/{{titleId}}/values
Content-Type: application/json

{
  "pid": {{pid}}
}

### Write a cheat's value into the game. A "value" is saved as the cheat's value first; without
# one the saved value is written. Returns the cheat and the value it replaced ("oldValue").
POST {{host}}/api/cheats/{{titleId}}/{{cheat}}/write
Content-Type: application/json

{
  "pid": {{pid}},
  "value": "999999"
}

### Lock a cheat: written now, then every ~200 ms until unlock, delete or disconnect
POST {{host}}/api/cheats/{{titleId}}/{{cheat}}/lock
Content-Type: application/json

{
  "pid": {{pid}}
}

### Unlock it (fine when it isn't locked; needs no connection)
POST {{host}}/api/cheats/{{titleId}}/{{cheat}}/unlock

### Edit a cheat: only the fields you send change ("" clears section or sectionStart). Writes
# no memory, but a locked cheat goes on writing its new value.
PUT {{host}}/api/cheats/{{titleId}}/{{cheat}}
Content-Type: application/json

{
  "description": "Money (max)"
}

### Export the game's cheat list as a file (<TITLEID>.json)
GET {{host}}/api/cheats/{{titleId}}/export

### Every game with a saved cheat list
GET {{host}}/api/cheats

### Delete a cheat (204; a locked cheat is unlocked first)
DELETE {{host}}/api/cheats/{{titleId}}/{{cheat}}

### Resume the game if it was left paused (scans with pauseGame resume it themselves; this is
# for a game left stopped, e.g. after the connection dropped mid-scan)
POST {{host}}/api/processes/{{pid}}/resume

### Disconnect (always 200)
POST {{host}}/api/disconnect

### Connect when the payload is already running. With no ip this uses PS4_IP, then
# ps4ip.local, then the saved IP. To pick the IP yourself, send {"ip": "<PS4_IP>"} instead.
POST {{host}}/api/connect
Content-Type: application/json

{}

### Disconnect again
POST {{host}}/api/disconnect
